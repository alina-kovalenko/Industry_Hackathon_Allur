    "/": {
      "get": {
        "summary": "Index",
        "operationId": "index__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssistantInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "scheduled_hours": {
            "type": "number",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Scheduled Hours",
            "default": 8
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AssistantInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestInput": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/ProductionRecord"
            },
            "type": "array",
            "maxItems": 3000,
            "minItems": 1,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records"
        ],
        "title": "IngestInput"
      },
      "PredictionInput": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/ProductionRecord"
            },
            "type": "array",
            "maxItems": 3000,
            "minItems": 1,
            "title": "Records"
          },
          "scheduled_hours": {
            "type": "number",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Scheduled Hours",
            "default": 8
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records"
        ],
        "title": "PredictionInput"
      },
      "ProductionRecord": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "line_id": {
            "type": "string",
            "enum": [
              "welding",
              "painting",
              "assembly"
            ],
            "title": "Line Id"
          },
          "planned_units": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Planned Units"
          },
          "actual_units": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Actual Units"
          },
          "runtime_hours": {
            "type": "number",
            "maximum": 24.0,
            "minimum": 0.0,
            "title": "Runtime Hours"
          },
          "utilization_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Utilization Pct"
          },
          "defects": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Defects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "line_id",
          "planned_units",
          "actual_units",
          "runtime_hours",
          "utilization_pct",
          "defects"
        ],
        "title": "ProductionRecord"
      },
      "ScenarioInput": {
        "properties": {
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "scheduled_hours": {
            "type": "number",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Scheduled Hours",
            "default": 8
          },
          "downtime_reduction_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Downtime Reduction Pct",
            "default": 30
          },
          "defect_reduction_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Defect Reduction Pct",
            "default": 20
          },
          "capacity_increase_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Capacity Increase Pct",
            "default": 10
          },
          "working_days": {
            "type": "integer",
            "maximum": 31.0,
            "minimum": 1.0,
            "title": "Working Days",
            "default": 22
          },
          "shifts_per_day": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Shifts Per Day",
            "default": 2
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ScenarioInput"
      },
      "SectionState": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "welding",
              "painting",
              "assembly"
            ],
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "warning",
              "stopped"
            ],
            "title": "Status",
            "description": "Учебный статус агрегированного периода, не телеметрия текущего момента."
          },
          "throughput": {
            "type": "number",
            "minimum": 0.0,
            "title": "Throughput",
            "description": "Валовой выпуск в авто/час календарного периода: actual_units / scheduled_hours."
          },
          "queue": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue",
            "description": "Очередь в автомобилях; null означает отсутствие данных."
          },
          "downtime_minutes": {
            "type": "number",
            "minimum": 0.0,
            "title": "Downtime Minutes",
            "description": "Сумма событий оборудования участка за выбранную дату, минуты."
          },
          "defect_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Defect Rate",
            "description": "Доля брака 0..1, не проценты."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "throughput",
          "downtime_minutes",
          "defect_rate"
        ],
        "title": "SectionState"
      },
      "StateResponse": {
        "properties": {
          "sections": {
            "items": {
              "$ref": "#/components/schemas/SectionState"
            },
            "type": "array",
            "title": "Sections"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sections"
        ],
        "title": "StateResponse"
      },
      "StopScenarioInput": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "welding",
              "painting",
              "assembly"
            ],
            "title": "Id"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "equipment_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Equipment Id"
          },
          "stop_minutes": {
            "type": "number",
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Stop Minutes"
          },
          "horizon_minutes": {
            "type": "number",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Horizon Minutes",
            "default": 480
          },
          "scheduled_hours": {
            "type": "number",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Scheduled Hours",
            "default": 8
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "equipment_id",
          "stop_minutes"
        ],
        "title": "StopScenarioInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
